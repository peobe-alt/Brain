# Cle API Claude (https://console.anthropic.com) - requise pour l'analyse experte
ANTHROPIC_API_KEY=

# Modele utilise pour l'expertise (vision + texte)
CAREXPERT_MODEL=claude-opus-5

# Base de donnees (SQLite par defaut, Postgres possible en production)
CAREXPERT_DATABASE_URL=sqlite:///data/carexpert.db

# Politique de collecte
CAREXPERT_RESPECT_ROBOTS=true
CAREXPERT_REQUEST_DELAY=2.5
CAREXPERT_USER_AGENT=CarExpertBot/0.1 (+contact: your@email.com)

# Budget analyse: nombre max de photos envoyees a Claude par annonce
CAREXPERT_MAX_PHOTOS=8
# Seuil de score a partir duquel une alerte est envoyee
CAREXPERT_ALERT_THRESHOLD=75

# Notifications (optionnel)
CAREXPERT_TELEGRAM_BOT_TOKEN=
CAREXPERT_TELEGRAM_CHAT_ID=
CAREXPERT_WEBHOOK_URL=
